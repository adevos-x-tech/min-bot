# ==============================================
# ADEVOS MIN-BOT - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to version control.
# ==============================================

# --- Server ---
PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.example.com

# --- Database ---
# MongoDB Atlas connection string (or any MongoDB instance)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/adevos-min-bot

# --- Authentication / Security ---
# Long random string used to sign session tokens
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin panel credentials (used only for the /admin login route)
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
# Comma separated list of Telegram user IDs allowed to bypass membership checks
TELEGRAM_OWNER_IDS=000000000

# Comma separated list of channel/group usernames that users must join
# before they can use the Telegram bot (e.g. @channel1,@channel2)
TELEGRAM_REQUIRED_CHANNELS=@your_channel

# --- WhatsApp Bot ---
# Maximum number of concurrent WhatsApp sessions this server instance may host
WHATSAPP_MAX_SESSIONS=50
# Comma separated WhatsApp group invite codes bots should auto-join on connect
WHATSAPP_AUTOJOIN_GROUPS=
# Comma separated WhatsApp newsletter/channel JIDs to auto-follow on connect
WHATSAPP_AUTOFOLLOW_CHANNELS=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
